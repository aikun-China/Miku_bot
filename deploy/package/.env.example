# MikuBot 环境配置模板
# 首次部署时会自动复制为 .env；首次启动会引导设置管理员 QQ 与 WebUI 密码。

ENVIRONMENT=prod
DRIVER=~fastapi
HOST=0.0.0.0
PORT=3108
LOG_LEVEL=INFO
FASTAPI_RELOAD=false

# 超级用户（管理员 QQ 号，用于「重启」等管理指令）
# 保持空列表即可，首次启动向导会让你输入
SUPERUSERS=[]

# WebUI 登录密码（只验证密码，不需要账号）
# 保持默认值即可，首次启动向导会让你修改
WEBUI_PASSWORD="miku8888"

COMMAND_START=["/", "", "!", "！"]
NICKNAME=["Miku", "miku", "初音", "初音未来"]

petpet_resource_url=https://fastly.jsdelivr.net/gh/noneplugin/nonebot-plugin-petpet@v0.3.x/resources
